{
  "name": "bookmarks-api",
  "version": "1.0.0",
  "description": "Example multi-user bookmarks API backed by pocket-db, showcasing expediate's apiBuilder and JWT plugin.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
